{
  "apiType": "stageMode",
  "buildOption": {
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "debug",
      "arkOptions": {
        "buildProfileFields": {
          "runtimeMode": "debug",
          "backendApiUrl": "http://127.0.0.1:8000/api/v1",
          "debugAuthToken": "change-me"
        }
      }
    },
    {
      "name": "release",
      "arkOptions": {
        "buildProfileFields": {
          "runtimeMode": "release",
          "backendApiUrl": "",
          "debugAuthToken": ""
        },
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "buildModeBinder": [
    {
      "buildModeName": "debug",
      "mappings": [{ "targetName": "default", "buildOptionName": "debug" }]
    },
    {
      "buildModeName": "release",
      "mappings": [{ "targetName": "default", "buildOptionName": "release" }]
    }
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest",
    }
  ]
}
