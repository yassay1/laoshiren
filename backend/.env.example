APP_ENV=development
APP_NAME=laoshiren-backend
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://laoshiren:laoshiren@localhost:5432/laoshiren
REDIS_URL=redis://localhost:6379/0
REDIS_WAKEUP_ENABLED=true
LOG_LEVEL=INFO

# Development-only single-user authentication. Replace before public deployment.
DEV_AUTH_TOKEN=change-me
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Huawei Account server-side exchange. Stub remains the development default.
HUAWEI_ACCOUNT_MODE=stub
HUAWEI_ACCOUNT_CLIENT_ID=
HUAWEI_ACCOUNT_CLIENT_SECRET=
HUAWEI_ACCOUNT_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
HUAWEI_ACCOUNT_TOKEN_INFO_URL=https://oauth-api.cloud.huawei.com/rest.php?nsp_fmt=JSON&nsp_svc=huawei.oauth2.user.getTokenInfo
HUAWEI_ACCOUNT_REDIRECT_URI=
HUAWEI_ACCOUNT_TIMEOUT_SECONDS=10

# Model provider is intentionally unset until the project owner supplies it.
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-flash
MODEL_API_BASE=https://api.deepseek.com
MODEL_API_KEY=
MODEL_FALLBACK_PROVIDER=
MODEL_FALLBACK_NAME=
MODEL_FALLBACK_API_BASE=
MODEL_FALLBACK_API_KEY=
MODEL_TIMEOUT_SECONDS=60
