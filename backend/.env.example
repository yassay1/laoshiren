APP_ENV=development
APP_NAME=laoshiren-backend
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://laoshiren:laoshiren@localhost:5432/laoshiren
LOG_LEVEL=INFO

# Development-only single-user authentication. Replace before public deployment.
DEV_AUTH_TOKEN=change-me
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Model provider is intentionally unset until the project owner supplies it.
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-flash
MODEL_API_BASE=https://api.deepseek.com
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
